# Gốc URL công khai của web — dùng cho RSS, sau này cho sitemap/robots.
# Dev: sao chép file này thành .env.local (file DUY NHẤT script pnpm tự đọc).
# Deploy thật: đặt trong .env.production, trỏ tường minh bằng --env-file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin API oRPC — origin TRẦN, không kèm /api (ADR-0016 §6)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side override (deploy nội bộ có thể trỏ URL private); dev để trống
API_URL=
# Secret route POST /api/revalidate (ADR-0016 §3) — dev để trống (fallback dùng
# DEV_REVALIDATE_SECRET); prod BẮT BUỘC đặt thật, khớp phía API.
REVALIDATE_SECRET=
# Cloud name Cloudinary — siết images.remotePatterns về đúng cloud của mình
# (W3-S4, ADR-0016 AMEND 1 §7). Thiếu thì build warn + mở /** như cũ.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
