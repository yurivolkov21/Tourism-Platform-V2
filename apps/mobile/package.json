{
  "name": "@tourism/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go",
    "dev:tunnel": "expo start --go --tunnel",
    "dev:lan": "expo start --go",
    "dev:client": "expo start --dev-client",
    "bundle": "expo export --platform ios --platform android",
    "eas-build-post-install": "pnpm -w exec turbo run build --filter=@tourism/mobile^...",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@orpc/client": "1.14.8",
    "@orpc/contract": "1.14.8",
    "@orpc/openapi-client": "1.14.8",
    "@orpc/tanstack-query": "1.14.8",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@tanstack/react-query": "^5.103.2",
    "@tourism/contract": "workspace:*",
    "@tourism/core": "workspace:*",
    "@tourism/i18n": "workspace:*",
    "@tourism/mobile-ui": "workspace:*",
    "better-auth": "1.6.23",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image": "^57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.4",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.4",
    "expo-doctor": "^1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "typescript"
      ]
    }
  }
}
