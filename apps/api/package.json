{
  "name": "@tourism/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --ignore '**/*.spec.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "pnpm build && node --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "fastify": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.43",
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.10"
  }
}
