NODE_ENV=development
PORT=3001
# Compose Postgres local (WSL). Prod/staging: override bằng connection string
# direct/session của Supabase — TUYỆT ĐỐI không dùng transaction pooler.
DATABASE_URL=postgresql://tourism:tourism@localhost:5432/tourism
# Bootstrap admin (dual-grant, comma list, case-insensitive): seed + Better Auth
# hook promote các email này lên ADMIN khi tạo user. Không bao giờ demote.
ADMIN_EMAILS=admin@tourism.test
# Better Auth. Secret ký session token — dev có default 'dev-secret-change-me',
# production BẮT BUỘC set giá trị thật (env.ts sẽ fail-fast nếu thiếu).
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3001
# Origin được phép gọi auth endpoints (CSRF) — web + admin local.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002
# Google OAuth (optional) — socialProviders.google chỉ bật khi có ĐỦ cặp.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
