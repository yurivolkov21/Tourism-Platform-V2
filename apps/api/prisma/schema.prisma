// Tourism v2 — Prisma schema (port từ Nexora, đã áp mọi audit delta).
// Nguồn: docs/specs/2026-07-18-schema-audit-nexora.md (H1-H6, H5b, M1-M8, LOW)
// và docs/specs/2026-07-18-p1-api-core.md §4.
// Phần hardening Prisma không diễn tả được (CHECK constraint, RLS) nằm ở
// `prisma/hardening-v2.sql` — apply như một migration ngay sau các schema
// migration. Connection URL nằm trong `prisma.config.ts` (Prisma 7).

generator client {
  provider               = "prisma-client"
  previewFeatures        = ["postgresqlExtensions"]
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum DepartureStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Payment rail cho một booking (ADR-0006, đã amend). Stripe = thẻ/ví,
/// PayPal = khách quốc tế.
enum PaymentProvider {
  STRIPE
  PAYPAL
}

/// Vòng đời lead cho "Inquire Now" (ADR-0003 — CRM).
enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Vòng đời support cho yêu cầu hủy một booking đã PAID.
enum CancellationRequestStatus {
  REQUESTED
  REFUNDED
  DENIED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaOwnerType {
  TOUR
  DESTINATION
  USER
  POST
  SITE
}

/// Slot mà một media asset chiếm trong owner của nó. Closed enum (security-first).
/// Giá trị cố tình giữ lowercase — đổi tên enum value sẽ âm thầm phá code đã
/// port (cùng loại hazard với note về thứ tự ReviewSource bên dưới).
enum MediaRole {
  hero
  gallery
  avatar
  body
}

/// Loại policy của tour (TourPolicy là model riêng).
enum PolicyKind {
  CANCELLATION
  BOOKING
  GENERAL
}

/// Nhóm traveller mà một tour phù hợp (merchandising).
enum TravellerType {
  FAMILY
  COUPLE
  FRIENDS
  SOLO
  BUSINESS
}

/// Độ khó của tour (audit M4 — trước là String tự do, DTO chỉ check độ dài).
enum TourDifficulty {
  EASY
  MODERATE
  CHALLENGING
}

/// VERIFIED = có từ booking thật; CURATED = testimonial do admin soạn.
///
/// Bất biến THẬT do CHECK `reviews_source_shape` ép (migration p3a_customer):
///   VERIFIED → tour_id, user_id, booking_id đều NOT NULL
///   CURATED  → booking_id NULL, user_id NULL; **tour_id được phép có giá trị**
/// (comment trong file migration ghi nhầm là "CURATED null cả 3" — migration đã
/// apply nên bất biến, đọc chỗ này mới đúng. Để tour_id mở là CỐ Ý: testimonial
/// admin soạn vẫn cần gắn được vào trang một tour cụ thể.)
/// ⚠️ Thứ tự alphabet (CURATED < VERIFIED) mang logic sort testimonial —
/// đổi tên value là phải sửa các query dùng nó (audit keep-list).
enum ReviewSource {
  VERIFIED
  CURATED
}

/// Badge merchandising trên tour card.
enum TourBadge {
  BEST_VALUE
  LIMITED_OFFER
  EXCLUSIVE
  NEW
  POPULAR
}

/// Loại transactional email cho outbox (ADR-0007).
enum EmailType {
  BOOKING_CONFIRMATION
  BOOKING_REFUNDED
  REVIEW_APPROVED
  ENQUIRY_RECEIVED
  /// Alert nội bộ cho admin khi có lead mới (A13 — Nexora chỉ gửi ack cho
  /// khách nên lead mới không ai biết cho tới khi mở CRM).
  ENQUIRY_ADMIN_ALERT
  CANCELLATION_REQUESTED
  CANCELLATION_APPROVED
  CANCELLATION_DENIED
  NEWSLETTER_WELCOME
  EMAIL_CHANGED
  /// Reset mật khẩu + xác minh email (AUTH-2, ADR-0008) — dây callback Better Auth
  /// vào outbox thay cho console.log stub.
  PASSWORD_RESET
  EMAIL_VERIFICATION
  /// Mã OTP verify email — ADR-0017 §5a (đè flow link mặc định bằng plugin
  /// `emailOTP`, giữ nguyên hook afterEmailVerification cho SEC-1).
  EMAIL_OTP
}

/// Vòng đời row outbox (ADR-0007). PENDING → SENT, hoặc → FAILED sau khi retry.
enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Vòng đời bài blog editorial. DRAFT → PUBLISHED.
enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ChatRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity — Better Auth v1.6 core schema (audit H5/H5b). Thay cho User kiểu
// Supabase-mirror cũ: bỏ supabaseId, bỏ locale; fullName → name. Domain
// additionalFields: phone + role. `deletedAt` là tombstone marker (H5b) —
// soft delete DUY NHẤT trong schema. Hook `beforeDelete` của BA set nó, scrub
// name/phone → null và email → deleted+<uuid>@tombstone.local, hard-delete
// sessions/accounts, và lật Review.authorDeleted. FK giữ Restrict — row user
// không bao giờ bị hard-delete.
// LƯU Ý: BA core khai `name` là required; ở đây nó nullable vì tombstone scrub
// set nó về null (spec §5). BA luôn ghi nó lúc signup.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  // Email unique case-insensitive nhờ Postgres citext (ADR-0008).
  email         String    @unique @db.Citext
  name          String?   @db.VarChar(120)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @db.VarChar(500)
  phone         String?   @db.VarChar(30)
  role          UserRole  @default(CUSTOMER)
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  accounts              Account[]
  bookings              Booking[]               @relation("BookingCustomer")
  refunds               Refund[]                @relation("RefundAdmin")
  reviews               Review[]
  moderatedReviews      Review[]                @relation("ModeratedReviews")
  wishlist              Wishlist[]
  posts                 Post[]
  cancellationRequests  CancellationRequest[]   @relation("CancellationRequester")
  cancellationDecisions CancellationRequest[]   @relation("CancellationDecider")
  enquiryNotes          EnquiryNote[]
  chatConversations     ChatConversation[]
  moderationEvents      ReviewModerationEvent[]

  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.VarChar(500)
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// TourCategory — bảng lookup
// ─────────────────────────────────────────────────────────────────────────────

model TourCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tours Tour[]

  @@index([isActive, order])
  @@map("tour_categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// Destination
// ─────────────────────────────────────────────────────────────────────────────

model Destination {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  country     String   @default("Vietnam") @db.VarChar(60)
  region      String?  @db.VarChar(80)
  description String?  @db.VarChar(2000)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tours TourDestination[]

  @@index([isActive])
  @@map("destinations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tour
// ─────────────────────────────────────────────────────────────────────────────

model Tour {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique @db.VarChar(120)
  title          String          @db.VarChar(200)
  summary        String?         @db.VarChar(500)
  categoryId     String          @map("category_id") @db.Uuid
  durationDays   Int             @map("duration_days")
  maxGroupSize   Int             @default(20) @map("max_group_size")
  basePrice      Decimal         @map("base_price") @db.Decimal(14, 2)
  // Chi phí trên mỗi traveller theo currency của tour (margin analytics).
  // Null = chưa biết → tính 0 cost (margin đọc như một cận trên).
  costPrice      Decimal?        @map("cost_price") @db.Decimal(14, 2)
  // Price anchoring — giá "compare at" / gạch ngang, optional.
  compareAtPrice Decimal?        @map("compare_at_price") @db.Decimal(14, 2)
  currency       String          @default("USD") @db.VarChar(3)
  difficulty     TourDifficulty?
  isPublished    Boolean         @default(false) @map("is_published")
  isFeatured     Boolean         @default(false) @map("is_featured")
  // Rating denormalized (audit A9): Nexora aggregate live mỗi page load
  // (`summarize()` scan toàn bảng reviews). Ở đây cập nhật trong CÙNG
  // transaction duyệt review nên không bao giờ lệch — xem ReviewsService.
  ratingAvg      Decimal?        @map("rating_avg") @db.Decimal(2, 1)
  ratingCount    Int             @default(0) @map("rating_count")
  // Merchandising — tour hợp với ai + badge trên card.
  suitableFor    TravellerType[] @default([]) @map("suitable_for")
  badges         TourBadge[]     @default([])
  // Array EN-only (ADR-0005) → Postgres text[].
  included       String[]        @default([])
  excluded       String[]        @default([])
  highlights     String[]        @default([])
  meetingPoint   String?         @map("meeting_point") @db.VarChar(300)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  category     TourCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  destinations TourDestination[]
  itinerary    TourItineraryDay[]
  departures   TourDeparture[]
  faqs         TourFaq[]
  policies     TourPolicy[]
  bookings     Booking[]
  reviews      Review[]
  wishlist     Wishlist[]
  enquiries    Enquiry[]
  posts        PostTour[]

  @@index([isPublished, categoryId])
  @@index([isFeatured, isPublished])
  @@index([categoryId])
  @@map("tours")
}

// ─────────────────────────────────────────────────────────────────────────────
// TourDestination — join M:N (ADR-0002), có cờ primary-destination
// ─────────────────────────────────────────────────────────────────────────────

model TourDestination {
  tourId        String  @map("tour_id") @db.Uuid
  destinationId String  @map("destination_id") @db.Uuid
  isPrimary     Boolean @default(false) @map("is_primary")

  tour        Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([tourId, destinationId])
  @@index([destinationId, isPrimary])
  @@map("tour_destinations")
}

// ─────────────────────────────────────────────────────────────────────────────
// TourItineraryDay — một row mỗi ngày
// ─────────────────────────────────────────────────────────────────────────────

model TourItineraryDay {
  id          String  @id @default(uuid()) @db.Uuid
  tourId      String  @map("tour_id") @db.Uuid
  dayNumber   Int     @map("day_number")
  title       String  @db.VarChar(200)
  description String? @db.VarChar(2000)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, dayNumber])
  @@map("tour_itinerary_days")
}

// ─────────────────────────────────────────────────────────────────────────────
// TourDeparture — ngày khởi hành cụ thể
// ─────────────────────────────────────────────────────────────────────────────

model TourDeparture {
  id             String          @id @default(uuid()) @db.Uuid
  tourId         String          @map("tour_id") @db.Uuid
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  priceOverride  Decimal?        @map("price_override") @db.Decimal(14, 2)
  // Price anchor ở cấp departure.
  compareAtPrice Decimal?        @map("compare_at_price") @db.Decimal(14, 2)
  seatsTotal     Int             @map("seats_total")
  seatsBooked    Int             @default(0) @map("seats_booked")
  status         DepartureStatus @default(OPEN)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tourId, startDate])
  @@map("tour_departures")
}

// ─────────────────────────────────────────────────────────────────────────────
// TourFaq
// ─────────────────────────────────────────────────────────────────────────────

model TourFaq {
  id       String @id @default(uuid()) @db.Uuid
  tourId   String @map("tour_id") @db.Uuid
  question String @db.VarChar(300)
  answer   String @db.VarChar(2000)
  order    Int    @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, order])
  @@map("tour_faqs")
}

// ─────────────────────────────────────────────────────────────────────────────
// TourPolicy — policy có cấu trúc
// ─────────────────────────────────────────────────────────────────────────────

model TourPolicy {
  id     String     @id @default(uuid()) @db.Uuid
  tourId String     @map("tour_id") @db.Uuid
  kind   PolicyKind
  title  String     @db.VarChar(200)
  body   String     @db.VarChar(4000)
  order  Int        @default(0)

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, order])
  @@map("tour_policies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking — multi-gateway (ADR-0006) + hardening tính toàn vẹn (ADR-0008).
// v2 (audit H1/H3): 4 cột audit `refunded*` nullable đã BỎ — tiền refund nằm
// trong ledger `Refund`; booking status suy ra từ SUM(refunds). Thêm các
// snapshot bất biến chụp lúc create (tourTitle, ngày departure, unitPrice) để
// booking lịch sử không render lại khi tour bị sửa (price+currency đã được
// snapshot từ trước).
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id                 String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(20)
  userId             String          @map("user_id") @db.Uuid
  tourId             String          @map("tour_id") @db.Uuid
  departureId        String          @map("departure_id") @db.Uuid
  numAdults          Int             @map("num_adults")
  numChildren        Int             @default(0) @map("num_children")
  totalAmount        Decimal         @map("total_amount") @db.Decimal(14, 2)
  currency           String          @default("USD") @db.VarChar(3)
  status             BookingStatus   @default(PENDING)
  // Snapshot lúc create (audit H3) — live join vẫn giữ cho tiện, mấy field này
  // đóng băng đúng thứ khách đã mua.
  tourTitle          String          @map("tour_title") @db.VarChar(160)
  departureStartDate DateTime        @map("departure_start_date") @db.Date
  departureEndDate   DateTime        @map("departure_end_date") @db.Date
  unitPrice          Decimal         @map("unit_price") @db.Decimal(14, 2)
  contactName        String          @map("contact_name") @db.VarChar(120)
  contactEmail       String          @map("contact_email") @db.VarChar(200)
  contactPhone       String?         @map("contact_phone") @db.VarChar(30)
  specialRequests    String?         @map("special_requests") @db.VarChar(1000)
  // Payment ref không phụ thuộc provider (ADR-0006). `providerSessionId` là id
  // của Checkout session; `providerPaymentId` là payment đã capture.
  paymentProvider    PaymentProvider @map("payment_provider")
  providerSessionId  String?         @unique @map("provider_session_id") @db.VarChar(255)
  providerPaymentId  String?         @map("provider_payment_id") @db.VarChar(255)
  paidAt             DateTime?       @map("paid_at")
  cancelledAt        DateTime?       @map("cancelled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user                 User                  @relation("BookingCustomer", fields: [userId], references: [id], onDelete: Restrict)
  tour                 Tour                  @relation(fields: [tourId], references: [id], onDelete: Restrict)
  departure            TourDeparture         @relation(fields: [departureId], references: [id], onDelete: Restrict)
  refunds              Refund[]
  reviews              Review[]
  cancellationRequests CancellationRequest[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([departureId])
  @@index([status, createdAt])
  @@index([tourId])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Refund — refund ledger append-only (audit H1). Thay cho Booking.refunded*.
// Refund một phần cộng dồn; booking status (REFUNDED/PARTIALLY_REFUNDED) suy ra
// từ SUM(amount) so với totalAmount. `adminId` null = đường tự động (vd
// auto-refund khi departure bị hủy); có giá trị = do admin phát hành.
// ─────────────────────────────────────────────────────────────────────────────

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  amount           Decimal  @db.Decimal(14, 2)
  currency         String   @db.VarChar(3)
  // Refund id phía provider (Stripe re_…, PayPal capture refund id). Unique để
  // một webhook retry không double-insert cùng một provider refund.
  providerRefundId String?  @unique @map("provider_refund_id") @db.VarChar(255)
  adminId          String?  @map("admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  admin   User?   @relation("RefundAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────────────────────────
// CancellationRequest — yêu cầu của khách đã PAID để hủy/refund một booking.
// Audit M7 ĐÓNG theo spec P2 §2 D1 (option B): các row là history APPEND-ONLY —
// mỗi yêu cầu là một row MỚI, row DENIED không bao giờ bị tái dùng/ghi đè, nên
// audit trail của việc từ chối sống sót qua các lần re-request. "Một yêu cầu
// LIVE mỗi booking" được ép bằng một partial unique index mà schema DSL không
// diễn tả được (nằm trong migration `cancellation_request_history`):
//   CREATE UNIQUE INDEX cancellation_requests_one_live_per_booking
//     ON cancellation_requests (booking_id) WHERE status = 'REQUESTED';
// Đọc history = findMany({ orderBy: createdAt }). Ngữ nghĩa status:
// REQUESTED = live; DENIED = admin từ chối (booking không đụng tới); REFUNDED =
// đã xử lý bằng một approve → refund toàn bộ phần còn lại + booking CANCELLED
// (docs/conventions/booking-states.md).
// ─────────────────────────────────────────────────────────────────────────────

model CancellationRequest {
  id           String                    @id @default(uuid()) @db.Uuid
  bookingId    String                    @map("booking_id") @db.Uuid
  userId       String                    @map("user_id") @db.Uuid
  reason       String                    @db.VarChar(1000)
  status       CancellationRequestStatus @default(REQUESTED)
  decisionNote String?                   @map("decision_note") @db.VarChar(500)
  decidedById  String?                   @map("decided_by") @db.Uuid
  decidedAt    DateTime?                 @map("decided_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user      User    @relation("CancellationRequester", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy User?   @relation("CancellationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("cancellation_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Review — một cái mỗi booking (rating 1..5 ép bằng CHECK trong hardening-v2.sql).
// v2 (audit M1): `authorDeleted` là cờ tombstone denormalized, được lật bởi
// hook beforeDelete của Better Auth (updateMany) — sort public
// [authorDeleted asc, createdAt desc] chạy trên composite index, không join User.
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(uuid(7)) @db.Uuid
  // FK nullable để một testimonial CURATED tồn tại được mà không cần
  // booking/user/tour thật. Review VERIFIED giữ đủ cả ba.
  tourId         String?      @map("tour_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  bookingId      String?      @unique @map("booking_id") @db.Uuid
  rating         Int
  title          String?      @db.VarChar(120)
  body           String       @db.VarChar(2000)
  // Snapshot tên hiển thị (verified: copy từ user.name lúc create;
  // curated: admin nhập). Khi authorDeleted, render "Deleted account".
  authorName     String       @map("author_name") @db.VarChar(120)
  authorDeleted  Boolean      @default(false) @map("author_deleted")
  // Free-text "City, Country" — chỉ curated.
  authorLocation String?      @map("author_location") @db.VarChar(120)
  source         ReviewSource @default(VERIFIED)
  isFeatured     Boolean      @default(false) @map("is_featured")
  // Thứ tự testimonial trang chủ. Nexora sort bằng `orderBy source asc` —
  // chạy được CHỈ nhờ thứ tự alphabet enum (CURATED < VERIFIED); đổi tên
  // value là hỏng ngầm, không test nào bắt. Cột này làm ý định tường minh.
  featuredRank   Int?         @map("featured_rank")
  // Tên chuyến free-text cho row curated không có tourId.
  tripLabel      String?      @map("trip_label") @db.VarChar(160)
  isApproved     Boolean      @default(false) @map("is_approved")
  // Moderation audit: ai quyết định lần cuối + khi nào. Bị ghi đè khi
  // re-moderation — quyết định mới nhất thắng. SetNull giữ review nếu admin bị xóa.
  moderatedById  String?      @map("moderated_by") @db.Uuid
  moderatedAt    DateTime?    @map("moderated_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tour             Tour?                   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user             User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking          Booking?                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  moderatedBy      User?                   @relation("ModeratedReviews", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationEvents ReviewModerationEvent[]

  @@index([tourId, isApproved, authorDeleted, createdAt(sort: Desc)])
  @@index([userId])
  @@index([isApproved, isFeatured])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wishlist — PK ghép (user, tour)
// ─────────────────────────────────────────────────────────────────────────────

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  tourId    String   @map("tour_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([userId, tourId])
  @@index([tourId])
  @@map("wishlist")
}

// ─────────────────────────────────────────────────────────────────────────────
// PaymentEvent — log idempotency cho webhook, theo từng provider (ADR-0006).
// v2 (audit H4): denormalized `amount`/`currency`/`bookingId` để việc forensics
// tiền không phải parse JSON payload mỗi request. `bookingId` là con trỏ trần
// (KHÔNG FK) — một webhook có thể tham chiếu booking ta không resolve được, mà
// row log vẫn phải ghi được bất kể. Idempotency = @@unique([provider, eventId])
// với `processedAt NULL` ⇒ handler phải chạy lại (port giữ nguyên, keep-list).
// ─────────────────────────────────────────────────────────────────────────────

model PaymentEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(255)
  type        String          @db.VarChar(100)
  payload     Json
  amount      Decimal?        @db.Decimal(14, 2)
  currency    String?         @db.VarChar(3)
  bookingId   String?         @map("booking_id") @db.Uuid
  // NULL = đã nhận nhưng xử lý chưa xong → một provider retry phải CHẠY LẠI
  // handler (handler idempotent ở cấp booking).
  processedAt DateTime?       @map("processed_at")
  receivedAt  DateTime        @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@index([bookingId])
  @@index([provider, receivedAt])
  @@map("payment_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enquiry — lead "Inquire Now" (ADR-0003)
// ─────────────────────────────────────────────────────────────────────────────

model Enquiry {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String        @db.VarChar(120)
  // citext (audit A2): Nexora KHÔNG lowercase email nhưng repeat-lead lại
  // `groupBy(['email'])` so khớp chính xác → Jane@x.com và jane@x.com thành
  // hai lead khác nhau, tính năng phát hiện trùng hỏng âm thầm.
  email       String        @db.Citext
  phone       String?       @db.VarChar(30)
  message     String        @db.VarChar(2000)
  tourId      String?       @map("tour_id") @db.Uuid
  // Field lead có cấu trúc — đều optional (enquiry chung bỏ trống);
  // EN-only (ADR-0005). `interests` là multi-select tự do.
  nationality String?       @db.VarChar(80)
  travelDate  DateTime?     @map("travel_date") @db.Date
  groupSize   Int?          @map("group_size")
  budgetTier  String?       @map("budget_tier") @db.VarChar(40)
  interests   String[]      @default([])
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tour  Tour?         @relation(fields: [tourId], references: [id], onDelete: SetNull)
  notes EnquiryNote[]

  @@index([status, createdAt])
  @@index([tourId])
  @@index([email])
  @@map("enquiries")
}

/// Note CRM nội bộ trên một enquiry (chỉ admin, thread append-only).
/// `authorName` là snapshot để thread vẫn đọc được nếu tài khoản admin bị
/// xóa (`authorId` khi đó thành null qua SetNull).
model EnquiryNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  enquiryId  String   @map("enquiry_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name") @db.VarChar(200)
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@map("enquiry_notes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Subscriber — thu lead newsletter. Chỉ lưu ở DB (không ESP); endpoint subscribe
// public upsert theo email — citext làm việc dedupe HÀNG SUBSCRIBER được ép ở
// DB (audit M2). NHƯNG normalize lowercase trong service VẪN load-bearing cho
// `Outbox.dedupeKey` (@db.VarChar thường, không citext) — thiếu nó, hai biến
// thể hoa/thường của cùng một email sinh hai dedupeKey khác chuỗi và
// welcome email bị gửi hai lần (xem comment trong newsletter.service.ts).
// ─────────────────────────────────────────────────────────────────────────────

model Subscriber {
  id             String    @id @default(uuid(7)) @db.Uuid
  email          String    @unique @db.Citext
  source         String?   @db.VarChar(40)
  // Hủy đăng ký (audit A1): Nexora KHÔNG có unsubscribe công khai — rủi ro
  // pháp lý GDPR/CAN-SPAM. Soft-unsubscribe giữ được bằng chứng consent,
  // khác hẳn hard-delete của Nexora.
  unsubscribedAt DateTime? @map("unsubscribed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("subscribers")
}

// ─────────────────────────────────────────────────────────────────────────────
// MediaAsset — dựa trên Cloudinary, polymorphic theo (ownerType, ownerId).
// Không FK cứng (thực dụng) — toàn vẹn nhờ một reconcile job + cleanup cùng tx.
// Lưu public_id của Cloudinary; delivery URL suy ra lúc đọc.
// ─────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String         @id @default(uuid()) @db.Uuid
  publicId    String         @map("public_id") @db.VarChar(300)
  type        MediaType
  ownerType   MediaOwnerType @map("owner_type")
  ownerId     String         @map("owner_id") @db.Uuid
  role        MediaRole
  format      String?        @db.VarChar(10)
  width       Int?
  height      Int?
  durationSec Float?         @map("duration_sec")
  posterId    String?        @map("poster_id") @db.VarChar(300)
  bytes       Int?
  // Alt text sửa được (media library của admin) — web fallback về text suy từ
  // owner khi null.
  alt         String?        @db.VarChar(300)
  // Ghi công nguồn ảnh (ADR-0020). Nullable vì không phải nguồn nào cũng đòi:
  // Pixabay không bắt ghi công, ảnh tự chụp cũng không. Nhưng ảnh Commons thì
  // CÓ — đo được chỉ 8-10% file là CC0/PD, phần còn lại là CC BY / CC BY-SA,
  // với chúng ghi công là ĐIỀU KIỆN của giấy phép chứ không phải phép lịch sự.
  //
  // `license` giữ nguyên chuỗi nguồn công bố ('CC BY-SA 4.0', 'Public domain')
  // chứ không ép enum: phiên bản quyết định nghĩa vụ, ép enum là mất thông tin.
  author      String?        @db.VarChar(200)
  license     String?        @db.VarChar(60)
  licenseUrl  String?        @map("license_url") @db.VarChar(300)
  sourceUrl   String?        @map("source_url") @db.VarChar(500)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Một row mỗi owner+publicId — cho registerAsset upsert thay vì race
  // findFirst-rồi-create. Cố tình per-owner (KHÔNG global) — reuse picker.
  @@unique([ownerType, ownerId, publicId])
  @@index([ownerType, ownerId, role])
  @@index([publicId])
  @@index([posterId])
  @@index([ownerType, createdAt])
  @@map("media_assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// SiteMediaSlot — một row mỗi slot ảnh brand-chrome trên web public. Catalog
// các key/kind nằm trong code API; bảng này chỉ cấp cho mỗi slot một uuid ổn
// định để ảnh của nó nằm trong media_assets (ownerType=SITE).
// ─────────────────────────────────────────────────────────────────────────────

model SiteMediaSlot {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_media_slots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Post — bài blog editorial (do agency soạn). Media cover/inline qua
// MediaAsset(ownerType=POST). Content là markdown, render sanitized phía
// client — KHÔNG phải Json block (quyết định blog-v2 có chủ đích, keep-list).
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id              String     @id @default(uuid(7)) @db.Uuid
  slug            String     @unique @db.VarChar(80)
  title           String     @db.VarChar(160)
  excerpt         String?    @db.VarChar(300)
  content         String
  // Override SEO cho <title>/meta description (fallback về title/excerpt).
  metaTitle       String?    @map("meta_title") @db.VarChar(70)
  metaDescription String?    @map("meta_description") @db.VarChar(160)
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  authorId        String     @map("author_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags         PostTagLink[]
  relatedTours PostTour[]

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("posts")
}

// ─────────────────────────────────────────────────────────────────────────────
// PostTag — taxonomy blog tự do (tạo inline từ form post của admin).
// Slug là identity (đích upsert); tên hiển thị = casing của người viết đầu tiên.
// ─────────────────────────────────────────────────────────────────────────────

model PostTag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(60)
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  posts PostTagLink[]

  @@map("post_tags")
}

model PostTagLink {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// PostTour — "tours in this story" do admin curate (max 3 ép ở DTO).
// `order` = thứ tự pick. Xóa tour âm thầm bỏ link (post vẫn sống).
// ─────────────────────────────────────────────────────────────────────────────

model PostTour {
  postId String @map("post_id") @db.Uuid
  tourId String @map("tour_id") @db.Uuid
  order  Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([postId, tourId])
  @@index([tourId])
  @@map("post_tours")
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbox — outbox cho transactional email (ADR-0007).
//
// Một row được ghi NGUYÊN TỬ cùng state change mà nó thông báo (raw-SQL CTE
// hoặc $transaction ngắn). Một worker pg-boss drain các row PENDING oldest-first.
// `dedupeKey` làm pipeline idempotent dưới các lần webhook/handler retry
// (`ON CONFLICT DO NOTHING`); quy ước `<event>:<entityId>[:<state>]`, hậu tố
// uuid chỉ cho các event lặp lại chính đáng (audit M5). `id` do DB sinh
// (`gen_random_uuid()`) nên câu insert raw-SQL CTE không cần id phía client.
// Retention (audit M5): cron của worker xóa SENT > 30 ngày, giữ FAILED để triage.
// ─────────────────────────────────────────────────────────────────────────────

model Outbox {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        EmailType
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  dedupeKey   String       @unique @map("dedupe_key") @db.VarChar(200)
  lastError   String?      @map("last_error") @db.VarChar(1000)
  createdAt   DateTime     @default(now()) @map("created_at")
  processedAt DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox")
}

// ─────────────────────────────────────────────────────────────────────────────
// MediaGarbage — asset Cloudinary mồ côi đang chờ xóa.
// `publicId` UNIQUE nên các entry pending trùng gộp lại. `id` do DB sinh cho
// các insert raw-SQL (cùng lý do với Outbox).
// ─────────────────────────────────────────────────────────────────────────────

model MediaGarbage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId     String   @unique @map("public_id") @db.VarChar(300)
  // resource_type của Cloudinary ('image' | 'video') — destroy cần nó.
  resourceType String   @default("image") @map("resource_type") @db.VarChar(10)
  attempts     Int      @default(0)
  lastError    String?  @map("last_error") @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("media_garbage")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Concierge Chat. Danh tính guest = biết được uuid của conversation (rủi ro
// đã chấp nhận ở capstone); một conversation do user đã đăng nhập tạo sẽ gắn với
// userId và khi đó YÊU CẦU một Better Auth session khớp để đọc/tiếp tục
// (audit H6 — ownership gate chuyển khỏi Supabase JWT). Retention (H6): cron của
// worker dọn các conversation cũ (guest `userId IS NULL` trước) dùng index
// [updatedAt] bên dưới.
// ─────────────────────────────────────────────────────────────────────────────

model ChatConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@index([updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  // Thứ tự chèn trong conversation (createdAt có thể trùng trong cùng batch).
  seq            Int
  role           ChatRole
  // UIMessage của AI SDK lưu nguyên văn ({id, role, parts}) — không mất mát và
  // replay thẳng vào useChat trên web.
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// ReviewModerationEvent — lịch sử duyệt review, append-only (audit A8).
// ─────────────────────────────────────────────────────────────────────────────

/// Lịch sử duyệt review, append-only (audit A8). Nexora chỉ giữ
/// `moderatedById/moderatedAt` kiểu last-write-wins nên không trả lời được
/// "ai unapprove bài này 3 tuần trước và vì sao".
model ReviewModerationEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  reviewId     String   @map("review_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  fromApproved Boolean  @map("from_approved")
  toApproved   Boolean  @map("to_approved")
  note         String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@map("review_moderation_events")
}
