# apps/admin — mẫu env (quy ước tên file 19/07, xem CLAUDE.md §Gotchas).
# Dev: chép thành .env.local. Deploy: .env.production (gitignored, import Vercel).

# Origin API (KHÔNG kèm /api). Server đọc API_URL, browser + CSP connect-src
# đọc NEXT_PUBLIC_API_URL. Production: THIẾU là build đỏ, và host thật phải
# https (http chỉ được cho localhost) — ADR-0026 AMEND 3 §D.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL của chính admin app (canonical/redirect nội bộ nếu cần về sau).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Origin site khách (www) mà admin link sang: View on site, Forgot password, menu
# người dùng (G19). BẪY TÊN: NEXT_PUBLIC_SITE_URL ở trên là origin của CHÍNH admin.
# Không khai thì dev rơi về http://localhost:3000, production rơi về
# https://www.nexora-travel.agency — nên bản deploy không bắt buộc phải có biến này.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
