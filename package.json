{
  "name": "tourism-v2",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "gate": "turbo run build typecheck test && biome check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "ci:wait": "sh scripts/ci-wait.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "turbo": "2.10.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
