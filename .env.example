# Mẫu biến môi trường — copy thành `.env` rồi điền.
#
# Dev local KHÔNG cần file này: mọi biến đều có default trỏ vào Postgres
# compose (`docker compose up -d postgres`). Chỉ cần `.env` khi bạn muốn
# trỏ sang DB khác, hoặc bật thanh toán/email thật.
#
# Nguồn sự thật là `apps/api/src/config/env.ts` — sửa schema thì sửa cả đây.

# ─── Bắt buộc ở production (dev để trống là được) ────────────────────────
# Postgres direct/session connection, pool ~10.
# CẤM transaction pooler (Supabase port 6543): pg-boss và prepared statement
# sẽ hỏng — đó chính là thứ đã bẻ cong thiết kế của Nexora.
# Bỏ trống ở dev → dùng compose local. Ở production, bỏ trống hoặc để đúng
# chuỗi localhost đều bị chặn ngay lúc parse config.
DATABASE_URL=

# Secret ký session token của Better Auth. Sinh bằng: openssl rand -base64 32
# Ở production KHÔNG được để giá trị dev mặc định.
BETTER_AUTH_SECRET=

# ─── URL công khai (default trỏ localhost) ───────────────────────────────
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002
PORT=3001
NODE_ENV=development

# Email được tự động promote lên ADMIN lúc đăng ký (comma list). Không bao
# giờ demote — chỉ cấp quyền.
ADMIN_EMAILS=admin@tourism.test

# ─── Thanh toán — production cần ÍT NHẤT một bộ ĐẦY ĐỦ ───────────────────
# Nửa bộ không tính: gateway chỉ được đăng ký khi đủ cả bộ, thiếu thì
# webhook/create của provider đó trả 404.
# Đồ án: LUÔN dùng test/sandbox mode, không bao giờ live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── Optional ────────────────────────────────────────────────────────────
# Có key → worker gửi email thật qua Resend; không có → in ra console.
RESEND_API_KEY=
EMAIL_FROM=Tourism <noreply@tourism.test>

# Google OAuth — chỉ bật khi có ĐỦ cặp.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
