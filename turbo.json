{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", "generated/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL"],
      "passThroughEnv": ["SKIP_API_WARMUP", "API_WARMUP_DEADLINE_MS", "ALLOW_BUILD_WITH_SERVER"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["DATABASE_URL"]
    },
    "test:int": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
